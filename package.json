{
  "name": "@jelmore1674/build-changelog",
  "version": "2.0.2",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "__BUILD__": "################################################################################",
    "build": "ncc build src/index.ts -m",
    "build:actions": "pnpm build:enforcer && pnpm build:generate && pnpm build:notes",
    "build:enforcer": "ncc build src/enforcer.ts -m -o enforcer",
    "build:generate": "ncc build src/generate.ts -m -o generate",
    "build:notes": "ncc build src/notes.ts -m -o notes",
    "build:schema": "node ./src/utils/schema/index.ts",
    "__LINT__": "#################################################################################",
    "lint": "pnpm lint:biome && pnpm lint:dprint ",
    "lint:biome": "biome lint --error-on-warnings",
    "lint:dprint": "dprint check",
    "__TEST__": "#################################################################################",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "jelmore1674",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@iarna/toml": "2.2.5",
    "@jelmore1674/changelog": "^2.0.0",
    "@jelmore1674/github-action-helpers": "^1.0.0",
    "fs-extra": "11.3.4",
    "latest-semver": "^4.0.0",
    "semver": "^7.7.4",
    "yaml": "2.8.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/fs-extra": "11.0.4",
    "@types/iarna__toml": "2.0.5",
    "@types/node": "^24.0.0",
    "@types/semver": "7.7.1",
    "@vercel/ncc": "0.38.4",
    "@vitest/coverage-v8": "4.1.7",
    "commander": "15.0.0",
    "dprint": "0.54.0",
    "memfs": "^4.57.3",
    "nock": "^14.0.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.7"
  },
  "bin": {
    "bcl": "dist/index.js"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "engineStrict": true
}
